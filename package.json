{
    "name": "ngtcp2",
    "version": "0.0.0",
    "private": true,
    "description": "ngtcp2 fork — adds a cvmcrypt crypto backend",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "node scripts/build.mjs --all",
        "clean": "node scripts/build.mjs --clean",
        "test": "node scripts/build.mjs --lib --tests && node scripts/run-tests.mjs",
        "test:release": "node scripts/build.mjs --lib --tests --release && node scripts/run-tests.mjs",
        "test:asan": "node scripts/build.mjs --lib --tests --asan && node scripts/run-tests.mjs",
        "test:tsan": "node scripts/build.mjs --lib --tests --tsan && node scripts/run-tests.mjs",
        "crypto-test": "node scripts/build.mjs --lib && node scripts/crypto-test.mjs",
        "quic-interop": "node scripts/build.mjs --lib && node scripts/quic-interop.mjs"
    }
}
